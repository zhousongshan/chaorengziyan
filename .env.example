NODE_ENV=development

WEB_PORT=3000
API_HOST=127.0.0.1
API_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api/v1
# Optional server-only API address used by the web media proxy.
INTERNAL_API_BASE_URL=http://127.0.0.1:3001/api/v1
CORS_ORIGIN=http://127.0.0.1:3000
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
# 后端需要通过本机代理访问模型服务时填写，例如 http://127.0.0.1:6789
OUTBOUND_HTTP_PROXY_URL=

DATABASE_URL=postgresql://chaoren:chaoren@127.0.0.1:5432/chaoren_media
# 数据库集成测试专用；测试会拒绝连接 DATABASE_URL 或名称不含 test 的数据库。
TEST_DATABASE_URL=postgresql://chaoren:chaoren@127.0.0.1:5432/chaoren_media_test
REDIS_URL=redis://127.0.0.1:6379
TASK_QUEUE_NAME=media-generation
SUBJECT_INSPECTION_QUEUE_NAME=subject-consistency
CONVERSATION_QUEUE_NAME=conversation-turns
CONVERSATION_DISPATCH_INTERVAL_MS=2000
CONVERSATION_TURN_STALE_MS=180000
CONVERSATION_TURN_MAX_ENQUEUE_ATTEMPTS=12

STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=./.local-data/media

AUTHORIZATION_DRIVER=development
LOCAL_USER_ID=00000000-0000-4000-8000-000000000001

REQUIREMENT_AI_BASE_URL=https://jennyapi.site/v1
REQUIREMENT_AI_API_KEY=
REQUIREMENT_AI_MODEL=gpt-5.6-sol
REQUIREMENT_AI_TIMEOUT_MS=150000
REQUIREMENT_AI_TURN_BUDGET_MS=240000

# 提示词优化是独立业务节点，可单独配置多模态模型。
# API Key 留空时，测试期整组继承“正式需求理解”最终解析出的有效多模态配置。
PROMPT_OPTIMIZATION_AI_BASE_URL=
PROMPT_OPTIMIZATION_AI_API_KEY=
PROMPT_OPTIMIZATION_AI_MODEL=
PROMPT_OPTIMIZATION_AI_TIMEOUT_MS=

SUBJECT_INSPECTION_AI_BASE_URL=https://jennyapi.site/v1
SUBJECT_INSPECTION_AI_API_KEY=
SUBJECT_INSPECTION_AI_MODEL=gpt-5.6-sol
SUBJECT_INSPECTION_AI_TIMEOUT_MS=60000
SUBJECT_INSPECTION_WORKER_CONCURRENCY=2
SUBJECT_INSPECTION_JOB_ATTEMPTS=2
SUBJECT_INSPECTION_JOB_BACKOFF_MS=2000

CONVERSATION_RECENT_FULL_TURNS=20
CONVERSATION_MAX_CONTEXT_CHARACTERS=240000
CONVERSATION_MAX_CONTEXT_TOKENS=120000
CONVERSATION_IMAGE_TOKEN_ESTIMATE=4000

OPENAI_IMAGE_BASE_URL=https://xfastapi.ai
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_API_MODE=xfastapi

BYTEDANCE_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
BYTEDANCE_IMAGE_API_KEY=
BYTEDANCE_IMAGE_MODEL=

IMAGE_GENERATION_TIMEOUT_MS=300000
IMAGE_DOWNLOAD_TIMEOUT_MS=60000
IMAGE_WORKER_CONCURRENCY=2
# 独立输出单元重试退避时间；输出单元固定为首次执行加一次重试
IMAGE_JOB_BACKOFF_MS=2000
# 额外的供应商 CDN 下载域名，多个域名用逗号分隔；服务 API 域名会自动加入
IMAGE_DOWNLOAD_ALLOWED_HOSTS=xfastapi.ai
MAX_UPLOAD_BYTES=20971520
MAX_GENERATED_IMAGE_BYTES=31457280
MAX_UPLOAD_IMAGE_PIXELS=40000000
MAX_IMAGE_COUNT=8
ALLOWED_ASPECT_RATIOS=1:1,3:4,4:3,9:16,16:9
ENABLED_IMAGE_MODELS=bytedance-image,openai-image

LOG_LEVEL=info
