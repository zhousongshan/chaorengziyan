{
  "name": "@chaoren/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "pretest:integration": "pnpm --filter @chaoren/database db:migrate:test",
    "test:integration": "RUN_DATABASE_TESTS=1 vitest run test/persistence.integration.test.ts test/*.persistence.integration.test.ts"
  },
  "dependencies": {
    "@chaoren/contracts": "workspace:*",
    "@chaoren/database": "workspace:*",
    "@chaoren/image-generation": "workspace:*",
    "@chaoren/storage": "workspace:*",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@nestjs/platform-fastify": "^11.1.12",
    "bullmq": "^5.70.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "ioredis": "^5.9.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "undici": "^8.10.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
