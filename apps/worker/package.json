{
  "name": "@chaoren/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "pretest:integration": "pnpm --filter @chaoren/database db:migrate:test",
    "test:integration": "RUN_WORKER_INTEGRATION_TESTS=1 vitest run --no-file-parallelism test/*.integration.test.ts"
  },
  "dependencies": {
    "@chaoren/contracts": "workspace:*",
    "@chaoren/database": "workspace:*",
    "@chaoren/image-generation": "workspace:*",
    "@chaoren/storage": "workspace:*",
    "@chaoren/subject-consistency": "workspace:*",
    "bullmq": "^5.70.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.9.3",
    "sharp": "^0.35.3",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
